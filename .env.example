# PostgreSQL
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh

# Frontend (dev local)
VITE_API_URL=http://localhost:3001
# En prod, VITE_API_URL est injecté via build arg Docker (docker-compose.prod.yml)
# Pour build l'APK Android : VITE_API_URL=https://apimuscuv2.chocot.be npm run build
